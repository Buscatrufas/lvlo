{
	email {$ACME_EMAIL}
}

# Cabeceras de seguridad comunes
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Política de contenidos común a la landing y a la app
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://{$STATS_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} https://{$STATS_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# ---------- lvlo.app: landing pública con lista de espera ----------
{$ROOT_DOMAIN} {
	import seguridad
	import csp
	encode zstd gzip

	# Tipografías, iconos, configuración y páginas legales se comparten con la app
	@compartido path /fonts/* /icons/* /vendor/* /config.js /styles.css /privacidad.html /aviso-legal.html /borrar-cuenta.html /borrar-cuenta.js
	handle @compartido {
		root * /srv/web
		file_server
	}
	handle {
		root * /srv/landing
		try_files {path} /index.html
		file_server
	}
	header /config.js Cache-Control "no-cache"
	@static path /fonts/* /icons/* /vendor/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}

# ---------- getlvlo.com y www.getlvlo.com: redirección permanente ----------
{$REDIRECT_DOMAINS} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

# ---------- app.lvlo.app: la app web (PWA) ----------
{$APP_DOMAIN} {
	import seguridad
	import csp
	root * /srv/web
	encode zstd gzip

	# El service worker, el manifiesto y la configuración no se cachean, para que las actualizaciones lleguen enseguida
	@nocache path /sw.js /index.html /config.js /manifest.webmanifest /.well-known/*
	header @nocache Cache-Control "no-cache"

	@static path /fonts/* /icons/* /vendor/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Necesario para Android (TWA): Digital Asset Links
	header /.well-known/assetlinks.json Content-Type "application/json"

	try_files {path} /index.html
	file_server
}

# ---------- api.lvlo.app: PocketBase (API y panel /_/) ----------
{$API_DOMAIN} {
	import seguridad
	request_body {
		max_size 10MB
	}
	reverse_proxy pocketbase:8090 {
		transport http {
			read_timeout 360s
		}
	}
}

# ---------- stats.lvlo.app: Umami ----------
{$STATS_DOMAIN} {
	import seguridad
	reverse_proxy umami:3000
}
